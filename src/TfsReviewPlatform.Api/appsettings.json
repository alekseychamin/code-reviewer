{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProviderCatalog": {
    "Profiles": [
      {
        "Id": "openai-default",
        "Name": "OpenAI Compatible",
        "Kind": "OpenAiCompatible",
        "BaseUrl": "https://api.openai.com/v1",
        "DefaultModel": "gpt-4.1-mini",
        "SupportsStructuredOutput": true,
        "LocalOnly": false,
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY"
      },
      {
        "Id": "ollama-local",
        "Name": "Local Ollama",
        "Kind": "Ollama",
        "BaseUrl": "http://localhost:11434",
        "DefaultModel": "qwen2.5-coder:14b",
        "SupportsStructuredOutput": false,
        "LocalOnly": true
      }
    ]
  },
  "ReviewRouting": {
    "DefaultProfileId": "openai-default",
    "Routes": [
      {
        "Stage": "ChangeDescription",
        "ProfileId": "openai-default",
        "Model": "gpt-4.1-mini",
        "Temperature": 0.1
      },
      {
        "Stage": "ChunkReview",
        "ProfileId": "openai-default",
        "Model": "gpt-4.1-mini",
        "Temperature": 0.0
      }
    ]
  },
  "ReviewPipeline": {
    "MaxChunkCharacters": 12000,
    "MaxPrimaryReviewChunkCharacters": 35000,
    "MaxChangeSummaryCharacters": 12000
  },
  "Qdrant": {
    "Enabled": false,
    "Url": "http://qdrant:6333",
    "ApiKey": "",
    "CollectionName": "review_semantic_index",
    "VectorSize": 1024,
    "TargetedTopK": 4,
    "GeneralTopK": 8,
    "EmbeddingBaseUrl": "http://host.docker.internal:11434",
    "EmbeddingModel": "bge-m3:latest"
  },
  "AzureDevOps": {
    "SkipCertificateValidation": false
  }
}
