{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProviderCatalog": {
    "Profiles": [
      {
        "Id": "openai-default",
        "Name": "OpenAI Compatible",
        "Kind": "OpenAiCompatible",
        "BaseUrl": "https://api.openai.com/v1",
        "DefaultModel": "gpt-4.1-mini",
        "SupportsStructuredOutput": true,
        "LocalOnly": false,
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY"
      },
      {
        "Id": "ollama-local",
        "Name": "Local Ollama",
        "Kind": "Ollama",
        "BaseUrl": "http://localhost:11434",
        "DefaultModel": "qwen2.5-coder:14b",
        "SupportsStructuredOutput": false,
        "LocalOnly": true
      }
    ]
  },
  "ReviewRouting": {
    "DefaultProfileId": "openai-default",
    "Routes": [
      {
        "Stage": "ChangeDescription",
        "ProfileId": "openai-default",
        "Model": "gpt-4.1-mini",
        "Temperature": 0.1
      },
      {
        "Stage": "ChunkReview",
        "ProfileId": "openai-default",
        "Model": "gpt-4.1-mini",
        "Temperature": 0.0
      }
    ]
  },
  "ReviewPipeline": {
    "MaxChunkCharacters": 12000,
    "MaxPrimaryReviewChunkCharacters": 35000,
    "MergePrimaryReviewChunks": false,
    "MaxConcurrentChunkReviews": 5,
    "MaxChunkToolRequests": 1,
    "MaxChangeSummaryCharacters": 12000,
    "SinglePassFullDiffAndGraphPrimaryReview": false,
    "SinglePassFullContextMaxCharacters": 0,
    "IncludeRoslynGraphInFullContextPayload": true,
    "FullContextMaxToolIterations": 2,
    "EnableDeterministicCoverageCritic": true,
    "EnableFinalModelNormalizationPass": true,
    "UseExternalReviewScoutMode": false,
    "UseIncrementalReviewMode": true,
    "ExternalReviewScoutMaxCriticCharacters": 26000,
    "MaxConcurrentExternalReviewScoutCritics": 3,
    "Roslyn": {
      "Enabled": true,
      "RestoreTimeoutSeconds": 900,
      "GraphTimeoutSeconds": 240,
      "MaxNeighborsPerAnchor": 24,
      "MaxNeighborSnippetCharacters": 1200,
      "MaxReferencesPerSymbol": 50,
      "IncludeReferenceEdges": false
    }
  },
  "ExternalReview": {
    "Enabled": false,
    "EngineName": "PR-Agent",
    "BaseUrl": "http://192.168.1.63:3005",
    "InputMode": "PullRequestUrl",
    "Commands": [ "describe" ],
    "ResponseLanguage": "ru-ru",
    "TimeoutSeconds": 360,
    "MaxWaitAtEndSeconds": 10,
    "UseChangeSummary": true,
    "ChangeSummaryWaitSeconds": 45,
    "UseReviewFindings": false
  },
  "Qdrant": {
    "Enabled": false,
    "Url": "http://qdrant:6333",
    "ApiKey": "",
    "CollectionName": "review_semantic_index",
    "VectorSize": 1024,
    "TargetedTopK": 4,
    "GeneralTopK": 8,
    "HistoricalFindingHalfLifeDays": 45,
    "EmbeddingBaseUrl": "http://host.docker.internal:11434",
    "EmbeddingModel": "bge-m3:latest"
  },
  "AzureDevOps": {
    "SkipCertificateValidation": false
  }
}
