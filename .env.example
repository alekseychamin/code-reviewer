# Copy this file to `.env` before running `docker compose up --build`.

# Shared compose settings
# Leave VITE_API_BASE_URL empty in docker compose so the browser uses same-origin requests
# through the Vite proxy. For non-docker local frontend runs, you can set it explicitly.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://api:8080

# LLM provider secrets
OPENAI_API_KEY=

# Optional: use DeepSeek via the first OpenAI-compatible profile (put your DeepSeek key in OPENAI_API_KEY).
# ProviderCatalog__Profiles__0__Name=DeepSeek
# ProviderCatalog__Profiles__0__BaseUrl=https://api.deepseek.com
# ProviderCatalog__Profiles__0__DefaultModel=deepseek-v4-pro
# ReviewRouting__Routes__0__Model=deepseek-v4-pro
# ReviewRouting__Routes__1__Model=deepseek-v4-pro

# Review pipeline sizing. DeepSeek v4 Pro has a large context window, so primary review
# keeps file-level review chunks while bounded parallelism reduces wall-clock time.
# ReviewPipeline__MaxPrimaryReviewChunkCharacters=35000
# ReviewPipeline__MergePrimaryReviewChunks=false
# ReviewPipeline__MaxConcurrentChunkReviews=3

# Pull request / merge request access tokens for diff acquisition and comment publishing
AZURE_DEVOPS_TOKEN=
GITHUB_TOKEN=
GITLAB_TOKEN=

# Optional internal NuGet feed for Docker build-time restore.
# Example (Azure Artifacts): https://pkgs.dev.azure.com/<org>/<project>/_packaging/<feed>/nuget/v3/index.json
NUGET_INTERNAL_FEED_URL=
NUGET_INTERNAL_FEED_USERNAME=
NUGET_INTERNAL_FEED_PASSWORD=

# By default the API container reaches Ollama running on the host machine via host.docker.internal.
# This is the recommended setup for docker compose, including remote Ubuntu hosts over SSH.
LOCAL_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Branch comparison reviews resolve repositories by folder name inside this mounted root.
HOST_REPOSITORIES_ROOT=/Users/Projects/
CONTAINER_REPOSITORIES_ROOT=/workspace/repos

# Optional PostgreSQL history storage for persistent review runs, findings, diagrams, and discussions
POSTGRES_DB=tfs_review
POSTGRES_USER=tfs_review
POSTGRES_PASSWORD=tfs_review
POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=tfs_review;Username=tfs_review;Password=tfs_review

# Optional Qdrant semantic index for prepared diff chunk retrieval in review follow-up questions
QDRANT_ENABLED=false
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=review_semantic_index
QDRANT_VECTOR_SIZE=1024
QDRANT_TARGETED_TOP_K=4
QDRANT_GENERAL_TOP_K=8
# Recency decay for historical finding retrieval. 45 means an otherwise equal old finding
# loses half of its semantic ranking weight every 45 days; set 0 to disable decay.
QDRANT_HISTORICAL_FINDING_HALF_LIFE_DAYS=45
QDRANT_EMBEDDING_BASE_URL=http://host.docker.internal:11434
QDRANT_EMBEDDING_MODEL=bge-m3:latest

# Optional Roslyn graph bootstrap timeout in seconds for workspace restore.
# Increase when building graph on large service repositories.
REVIEW_ROSLYN_RESTORE_TIMEOUT_SECONDS=900

# Optional: build SymbolFinder reference edges (REFERENCED_BY) for types in changed files — slower graph step, richer Related context (RefSite).
# REVIEW_ROSLYN_INCLUDE_REFERENCE_EDGES=true

# Experimental: primary review is full-context (full diff + full Roslyn graph JSON) with tool loop.
# true = full-context + tools; false = classic chunk review + tools.
# REVIEW_SINGLE_PASS_FULL_CONTEXT=true
# REVIEW_SINGLE_PASS_MAX_CHARS=500000
# Include graph JSON in full-context payload (set false to test full diff + tools without graph).
# REVIEW_INCLUDE_ROSLYN_GRAPH_IN_FULL_CONTEXT=false
# Max tool-loop iterations for full-context mode (initial pass + refinements).
# REVIEW_FULL_CONTEXT_MAX_TOOL_ITERATIONS=2

# Final model normalization pass: dedupe/merge findings and return strict JSON for reporting.
# REVIEW_FINAL_MODEL_NORMALIZATION=true

# Optional examples for future provider profiles or self-hosted OpenAI-compatible endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# If you use the Ollama service from docker compose instead of host Ollama:
# LOCAL_OLLAMA_BASE_URL=http://ollama:11434
# docker compose --profile local-llm up --build
# If you enable semantic retrieval for review follow-ups:
# docker compose --profile semantic-index up --build
