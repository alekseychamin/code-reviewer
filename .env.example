# Copy this file to `.env` before running `docker compose up --build`.

# Shared compose settings
# Leave VITE_API_BASE_URL empty in docker compose so the browser uses same-origin requests
# through the Vite proxy. For non-docker local frontend runs, you can set it explicitly.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://api:8080

# LLM provider secrets
OPENAI_API_KEY=

# Azure DevOps / TFS access token for PR diff acquisition and comment publishing
AZURE_DEVOPS_TOKEN=

# Optional examples for future provider profiles or self-hosted OpenAI-compatible endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# LOCAL_OLLAMA_BASE_URL=http://ollama:11434
